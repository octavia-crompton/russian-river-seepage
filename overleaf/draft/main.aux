\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Berm crest elevation as a function of time, showing the median (blue dots) and range of four transects across the berm. Photos taken on November 11, 2012 and December 5, 2020, illustrating larger interannual changes in the berm shape. In 2012, large $C$ is consistent with a narrowing berm by the jetty. Likewise, in 2020, small $C$ is consistent with the wider berm shape. }}{16}{figure.7}\protected@file@percent }
\newlabel{fig:berm_crest}{{7}{16}{Berm crest elevation as a function of time, showing the median (blue dots) and range of four transects across the berm. Photos taken on November 11, 2012 and December 5, 2020, illustrating larger interannual changes in the berm shape. In 2012, large $C$ is consistent with a narrowing berm by the jetty. Likewise, in 2020, small $C$ is consistent with the wider berm shape}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Photos taken November 7, 2018 and December 8, 2018, illustrate how the berm shape varies little over subsequent closures within the same year. }}{16}{figure.8}\protected@file@percent }
\newlabel{fig:2018_closures}{{8}{16}{Photos taken November 7, 2018 and December 8, 2018, illustrate how the berm shape varies little over subsequent closures within the same year}{figure.8}{}}

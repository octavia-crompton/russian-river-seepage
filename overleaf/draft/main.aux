\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Comparing exponent fits for three longest closures in 2012: (A) a 36 day closure starting on September 17, 2014 (see also Figure \ref {fig:overwash}), (B) a 31 day closure starting on September 26, 2020, (C) a 29 day closure starting on October 16, 2018, and (D) all closure events combined. The closures in panels B and C are shown in further detail in SI Figures S1 and S2 (analogous to Figure \ref {fig:overwash}). }}{11}{figure.5}\protected@file@percent }
\newlabel{fig:compare_fits}{{5}{11}{Comparing exponent fits for three longest closures in 2012: (A) a 36 day closure starting on September 17, 2014 (see also Figure \ref {fig:overwash}), (B) a 31 day closure starting on September 26, 2020, (C) a 29 day closure starting on October 16, 2018, and (D) all closure events combined. The closures in panels B and C are shown in further detail in SI Figures S1 and S2 (analogous to Figure \ref {fig:overwash})}{figure.5}{}}
